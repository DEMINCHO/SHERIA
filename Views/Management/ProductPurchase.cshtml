@section PageStyles{
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/static/css/pretty-checkbox.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
   @*  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css"> *@
}
<!-- begin page-header -->
<h1 class="page-header"><i class="fa-regular fa-book"></i> Open <small> Matters </small></h1>
<!-- end page-header -->
<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("OpenMatters", "Matters")" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fas fa-undo"></i></a>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
        </div>
        <h4 class="panel-title">Product Record</h4>
    </div>
    <div class="panel-body">
        <p></p>
        @* <div class="form-horizontal">*@
        <div class="row">
            <div class="col-md-6 col-sm-6 col-xs-12">
                <a id="editabledatatable_new" class="btn btn-sm btn-success" data-toggle="modal" data-target="#capture-matters">
                    <i class="fa fa-plus"></i> Issue Product
                </a>
                <br />
                <br />
            </div> 
            <div class="col-md-6 col-sm-6 col-xs-12">
                <a id="editabledatatable_new" class="btn btn-sm btn-success" data-toggle="modal" data-target="#payment">
                    <i class="fa fa-plus"></i> PAYMENT
                </a>

                <br />
                <br />
            </div>
           
            
        </div>
        <div class="row">
            <table id="editabledatatable" class="table table-striped table-hover table-bordered table-condensed">
                <thead>
                    <tr role="row">
                        <th style="width:auto">Client Name</th>
                        <th style="width:auto">Product Name</th>
                        <th style="width:auto">Assinged Date</th>
                        <th style="width:auto">Return Date</th>
                        <th style="width:auto">Quantity</th>
                        <th style="width:auto">Total Price</th>
                        <th style="width:auto"></th>
                       @*  <th style="width:auto"></th> *@
                    </tr>
                </thead>
            </table>
        </div>
        <div class="row">
            <div class="modal fade" id="capture-matters" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true"><i class="fa fa-times-circle"></i></button>
                            <h4 class="modal-title">Start New Matter</h4>
                        </div>
                        <div class="modal-body">
                            <div class="panel panel-inverse">
                                <div class="panel-body">
                                    <h4><b>1. Client Information</b></h4>
                                    <div class="row">
                                        <div class="col-md-3 col-sm-3 col-xs-12">
                                            <div class="form-group">
                                                <input id="recordid" type="hidden" name="recordid" />
                                                <input id="client_id" type="hidden" name="client_id" />
                                                <label for="client_name"><b>Client Name</b></label>
                                                <input type="text" id="client_name" name="client_name" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-3 col-xs-12">
                                            <div class="form-group">
                                                <label for="mobile"><b>Client Mobile</b></label>
                                                <input type="text" id="mobile" name="mobile" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-3 col-xs-12">
                                            <div class="form-group">
                                                <label for="email"><b>Client Email</b></label>
                                                <input type="text" id="email" name="email" class="form-control" />
                                                <span class="field-validation-valid" data-valmsg-replace="true" data-valmsg-for="email"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-3 col-xs-12">
                                            <div class="form-group">
                                                <label for="id_no"><b>ID NO</b></label>
                                                <input type="text" id="id_no" name="id_no" class="form-control" />
                                                <span class="field-validation-valid" data-valmsg-replace="true" data-valmsg-for="id_no"></span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <h4><b>2. Product Sale</b></h4>
                                        <div class="col-md-4 col-sm-4 col-xs-12">
                                            <div class="form-group">
                                                <label for="product"><b>Product</b></label>
                                                <select id="product" name="product" class="form-control selectpicker" style="width: 100%"></select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-4 col-xs-12">
                                            <div class="form-group">
                                                <label for="product_total"><b>Products Number</b></label>
                                                <input type="text" id="product_total" name="product_total" class="form-control" />
                                            </div>
                                        </div> 
                                        <div class="col-md-4 col-sm-4 col-xs-12">
                                            <div class="form-group">
                                                <label for="price"><b>Total Price</b></label>
                                                <input type="text" id="price" name="price" class="form-control" />
                                            </div>
                                        </div> 
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 col-sm-4 col-xs-12">
                                            <div class="form-group">
                                                <label for="start_date"><b>Pick Date</b></label>
                                                <input type="text" id="start_date" name="start_date" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-4 col-xs-12">
                                            <div class="form-group">
                                                <label for="return_date"><b>Return Date</b></label>
                                                <input type="text" id="return_date" name="return_date" class="form-control" />
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-white btn-sm" id="cancel" data-dismiss="modal"><i class="fa fa-times-circle"></i>&nbsp;Cancel</a>
                            <a href="#" class="btn btn-success btn-sm" id="save"><i class="fa fa-check-circle"></i>&nbsp;Submit</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="modal fade" id="payment" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true"><i class="fa fa-times-circle"></i></button>
                            <h4 class="modal-title">Make STK PUSH</h4>
                        </div>
                        <div class="modal-body">
                            <div class="panel panel-inverse">
                                <div class="panel-body">
                                    <div class="card-header p-0" id="headingThree">
                                        <h2 class="mb-0">
                                            <button class="btn btn-light btn-block text-left collapsed p-3 rounded-0 border-bottom-custom" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseTwo">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span>Mpesa</span>
                                                    <img src="~/assets/img/33.jpg" width="80">
                                                </div>
                                            </button>
                                        </h2>
                                    </div>

                                    <div class="card-body">
                                        <input id="mpesa" type="text" class="form-control" placeholder="Amount(KES)">
                                    </div>
                                    <br />
                                    <div class="card-body">
                                        <input id="mobile" type="text" class="form-control" placeholder="Phone Number">
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-white btn-sm" id="cancel" data-dismiss="modal"><i class="fa fa-times-circle"></i>&nbsp;Cancel</a>
                            <a href="#" class="btn btn-success btn-sm" id="save"><i class="fa fa-check-circle"></i>&nbsp;PAY</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*</div>*@
        <hr>
    </div>
    <!-- end panel-body -->
</div>

<!-- end panel -->

@section PageScripts{
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/assets/static/plugins/select2/dist/js/select2.min.js"></script>
    <script src="~/assets/static/plugins/dataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/assets/static/plugins/dataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/dataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/js/table-manage-responsive.demo.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/js/apps.min.js"></script>
    <script src="~/assets/static/js/jquery.blockUI.js"></script>
    <script src="~/assets/static/js/matters/purchase.js"></script>

}